# Copy to .env and fill in. Never commit .env.

# Retell dashboard → Keys → API Key (secret)
RETELL_API_KEY=

# Cal.com → Settings → Developer → API Keys
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_EVENT_SLUG=
CALCOM_BOOKING_URL=

# aistudio.google.com → Get API key
GEMINI_API_KEY=

# Retell dashboard → Keys → Public Key (safe in frontend)
RETELL_PUBLIC_KEY=
RETELL_AGENT_ID=
