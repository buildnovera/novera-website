# Private dashboard — set these as environment variables on the host.
# Never commit the filled-in version; .env is gitignored.

# ── access ───────────────────────────────────────────────────────────────────
# The single password for the dashboard. Make it long; there is no lockout.
DASH_PASSWORD=
# Used to sign the session cookie. Any random string of 32+ characters.
# Changing it signs everyone out.
DASH_SECRET=

# ── PostHog ──────────────────────────────────────────────────────────────────
# Personal API key with the query:read scope (Settings → Personal API keys).
# This is NOT the public project key that sits in src/analytics.js.
POSTHOG_API_KEY=
# Numeric project id — visible in the URL of any PostHog page, or via
# curl -H "Authorization: Bearer $POSTHOG_API_KEY" https://us.posthog.com/api/projects/
POSTHOG_PROJECT_ID=
# Leave unset for US cloud. EU cloud is https://eu.posthog.com
# (note: this is the app host, not the us.i.posthog.com ingest host)
POSTHOG_API_HOST=https://us.posthog.com

# ── commercial figures ───────────────────────────────────────────────────────
# LTV = setup + (monthly / churn). Churn is a percentage per month.
# Leave these empty and the dashboard shows the funnel with LTV marked unset,
# rather than inventing a number.
LTV_SETUP_FEE=
LTV_MONTHLY=
LTV_CHURN_PCT=
# Share of consultations that become paying customers. Only you know this.
CLOSE_RATE_PCT=

# ── optional: live revenue instead of the constants above ─────────────────────
# A HogQL query returning ONE row with columns: setup, monthly, churn_pct
# (and optionally close_pct). Point this at your Stripe warehouse tables once
# you have confirmed their names in PostHog. If it errors the dashboard falls
# back to the constants and says so on screen.
POSTHOG_REVENUE_SQL=
